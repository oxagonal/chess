# Copied into dist/ by the exporter. The app (another origin) fetches these files.
/*
  Access-Control-Allow-Origin: *
/manifest.json
  Cache-Control: no-cache
# The app adds ?r=<release> to these URLs, so they can be cached for good.
/names/*
  Cache-Control: public, max-age=31536000, immutable
/games/*
  Cache-Control: public, max-age=31536000, immutable
